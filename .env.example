# Copy this file to .env and fill values. Do not commit your real secrets.

# Google Generative AI (Gemini)
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemini-1.5-pro

# GCP Service Account JSON (entire JSON as a single line string)
# Alternatively, paste JSON in the Streamlit UI.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# AWS Credentials (only needed if testing AWS ingestion)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

